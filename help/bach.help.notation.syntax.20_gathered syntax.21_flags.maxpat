            {
                "box": {
                    "fontface": 0,
                    "fontname": "Arial",
                    "fontsize": 13.0,
                    "id": "obj-76",
                    "linecount": 5,
                    "maxclass": "bach.hypercomment",
                    "numinlets": 1,
                    "numoutlets": 1,
                    "outlettype": [ "" ],
                    "patching_rect": [ 6.0, 32.0, 607.0, 79.0 ],
                    "sendto": "bach.help.filtertags",
                    "text": "Each fundamental notation items (voice, measure, chord, note) has a flag, characterizing somehow the state of such element. Normally, this flag is 0 (default state), but this can be different than zeros if the notation item is muted, locked, set as \"solo\", or (in case of measures) if the rhythmic tree is locked. The notation item flag thus assumes the form of a bitfield: the number, in order to be understood, must be decomposed in sum of powers of two. ",
                    "textcolor": [ 0.5, 0.5, 0.5, 1.0 ]
                }
            }
