                    "text": "Tags: gathered, syntax, flag, notation, item, lock, mute, solo, rhythmic, tree, selected, select, selection, sel",
                    "textcolor": [ 0.5, 0.5, 0.5, 1.0 ],
                    "varname": "tags"
